#!/usr/bin/env bash
# Set or clear an emoji workflow status on the current tmux window.
#
# Usage:
#   tmux-window-status set <emoji>   # prefix the window name with <emoji>
#   tmux-window-status clear         # restore the original window name
#
# The original name is stashed in the window-local option @base-name on the
# first `set` call, so subsequent `set` calls only swap the emoji and `clear`
# restores the original.

set -euo pipefail

cmd="${1:-}"

case "$cmd" in
  set)
    emoji="${2:?usage: tmux-window-status set <emoji>}"
    base="$(tmux show -wv @base-name 2>/dev/null || true)"
    if [[ -z "$base" ]]; then
      base="$(tmux display-message -p '#W')"
      tmux set -w @base-name "$base"
    fi
    tmux rename-window "$emoji $base"
    ;;
  clear)
    base="$(tmux show -wv @base-name 2>/dev/null || true)"
    if [[ -n "$base" ]]; then
      tmux rename-window "$base"
      tmux set -uw @base-name
    fi
    ;;
  *)
    echo "usage: tmux-window-status set <emoji> | clear" >&2
    exit 2
    ;;
esac
