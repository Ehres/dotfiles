#!/bin/bash

set -uo pipefail

CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/gh-dash/reviewers"
SCORES_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gh-dash/reviewer-scores"

usage() {
  printf 'usage: %s {request|re-request} <owner/repo> <pr-number>\n' "$0" >&2
  exit 2
}

validate_repo() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    printf 'invalid repository: %s\n' "$1" >&2
    return 1
  }
}

cache_file() {
  printf '%s/%s\n' "$CACHE_ROOT" "$1"
}

refresh_cache() {
  local repo=$1 file temp_file
  file=$(cache_file "$repo")
  mkdir -p "$(dirname "$file")" || return 1
  temp_file=$(mktemp "${file}.tmp.XXXXXX") || return 1

  if ! gh api "repos/${repo}/collaborators?per_page=100" --paginate --jq '.[].login' \
    | LC_ALL=C sort -fu > "$temp_file"; then
    rm -f "$temp_file"
    printf 'could not refresh reviewers for %s\n' "$repo" >&2
    return 1
  fi

  mv "$temp_file" "$file"
}

print_candidates() {
  local repo=$1 refresh=${2:-false} file scores_source
  validate_repo "$repo" || return 1
  file=$(cache_file "$repo")

  if [ "$refresh" = true ] || [ ! -f "$file" ]; then
    refresh_cache "$repo" || return 1
  fi

  scores_source=$SCORES_FILE
  [ -f "$scores_source" ] || scores_source=/dev/null

  awk -v FS='\t' -v OFS='\t' '
    BEGIN {
      count = split(ENVIRON["pending_reviewers"], requests, "\n")
      for (i = 1; i <= count; i++) {
        if (requests[i] == "") continue
        key = tolower(requests[i])
        requested[key] = 1
        candidates[key] = requests[i]
      }
    }
    FILENAME == ARGV[1] {
      if ($1 != "" && $2 ~ /^[0-9]+$/) score[$1] = $2
      next
    }
    $0 != "" { candidates[tolower($0)] = $0 }
    END {
      for (key in candidates) {
        login = candidates[key]
        print (login in score ? score[login] : 0), login, login (key in requested ? " (remove request)" : "")
      }
    }
  ' "$scores_source" "$file" \
    | LC_ALL=C sort -t $'\t' -k1,1nr -k2,2f \
    | awk -v FS='\t' -v OFS='\t' '{ print $2, $3 }'
}

increment_scores() {
  local selection=$1 scores_source temp_file
  mkdir -p "$(dirname "$SCORES_FILE")" || return 1
  temp_file=$(mktemp "${SCORES_FILE}.tmp.XXXXXX") || return 1

  scores_source=$SCORES_FILE
  [ -f "$scores_source" ] || scores_source=/dev/null

  if ! awk -v FS='\t' -v OFS='\t' '
    FILENAME == ARGV[1] {
      if ($1 != "" && $2 ~ /^[0-9]+$/) score[$1] = $2
      next
    }
    $0 != "" { score[$0]++ }
    END {
      for (login in score) print login, score[login]
    }
  ' "$scores_source" <(printf '%s\n' "$selection") | LC_ALL=C sort -fu > "$temp_file"; then
    rm -f "$temp_file"
    return 1
  fi

  mv "$temp_file" "$SCORES_FILE"
}

request_review() {
  local repo=$1 pr=$2 file script_path reload_command selection fzf_status login
  local pending_reviewers add="" remove="" additions=""
  local -a flags=()
  validate_repo "$repo" || return 1
  [[ "$pr" =~ ^[0-9]+$ ]] || {
    printf 'invalid pull request number: %s\n' "$pr" >&2
    return 1
  }

  file=$(cache_file "$repo")
  [ -f "$file" ] || refresh_cache "$repo" || return 1
  pending_reviewers=$(gh pr view "$pr" --repo "$repo" --json reviewRequests \
    --jq '.reviewRequests[].login // empty') || return 1
  # Keep the same pending state when ctrl-r reloads candidates in a child process.
  export pending_reviewers

  script_path=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  printf -v reload_command '%q candidates %q --refresh' "$script_path" "$repo"

  selection=$(print_candidates "$repo" | fzf \
    --multi \
    --no-sort \
    --delimiter=$'\t' \
    --with-nth=2 \
    --accept-nth=1 \
    --header='tab: select | enter: toggle requests | ctrl-r: refresh' \
    --bind="ctrl-r:reload($reload_command)")
  fzf_status=$?

  if [ "$fzf_status" -eq 1 ] || [ "$fzf_status" -eq 130 ]; then
    return 0
  fi
  [ "$fzf_status" -eq 0 ] || return "$fzf_status"

  while IFS= read -r login; do
    [ -n "$login" ] || continue
    if grep -Fixq -- "$login" <<< "$pending_reviewers"; then
      remove="${remove:+${remove},}${login}"
    else
      add="${add:+${add},}${login}"
      additions="${additions:+${additions}$'\n'}${login}"
    fi
  done <<< "$selection"

  if [ -n "$add" ]; then
    increment_scores "$additions" || return 1
    flags+=(--add-reviewer "$add")
  fi
  [ -z "$remove" ] || flags+=(--remove-reviewer "$remove")
  [ -n "$add$remove" ] || return 0
  gh pr edit "$pr" --repo "$repo" "${flags[@]}"
}

re_request_review() {
  local repo=$1 pr=$2 candidates login status
  # The variables in the filter belong to jq.
  # shellcheck disable=SC2016
  candidates=$(gh pr view "$pr" --repo "$repo" --json author,latestReviews,reviewRequests --jq '
    .author.login as $author | [.reviewRequests[].login] as $pending |
    [.latestReviews[].author.login | select(. != null and . != $author and (endswith("[bot]") | not)) |
      select(. as $login | $pending | index($login) == null)] | unique[]') || return 1
  if [ -z "$candidates" ]; then
    printf 'No previous reviewer to re-request on %s#%s.\n' "$repo" "$pr"
    if [[ $in_popup == true ]]; then
      read -rp 'Press Enter to close… ' _
    fi
    return 0
  fi
  login=$(fzf --header='enter: re-request review | esc: cancel' <<< "$candidates")
  status=$?
  case "$status" in
    0) gh api --method POST "repos/$repo/pulls/$pr/requested_reviewers" -f "reviewers[]=$login" --silent ;;
    1|130) return 0 ;;
    *) return "$status" ;;
  esac
}

in_popup=false
if [[ "${1:-}" == --in-popup ]]; then
  in_popup=true
  shift
fi

case "${1:-}" in
  request|re-request)
    [ "$#" -eq 3 ] || usage
    validate_repo "$2" && [[ "$3" =~ ^[0-9]+$ ]] || usage
    if [[ $in_popup == false && -n ${REX_SESSION:-} && -n ${REX_BLOCK:-} ]]; then
      exec rex 'do' -s "$REX_SESSION" -b "$REX_BLOCK" dash_reviewer_picker "mode=$1" "repo=$2" "pr=$3"
    fi
    if [[ $1 == request ]]; then
      request_review "$2" "$3"
    else
      re_request_review "$2" "$3"
    fi
    status=$?
    if [[ $in_popup == true && $status != 0 ]]; then
      read -rp 'Press Enter to close… ' _
    fi
    exit "$status"
    ;;
  candidates)
    if [ "$#" -eq 2 ]; then
      print_candidates "$2"
    elif [ "$#" -eq 3 ] && [ "$3" = --refresh ]; then
      print_candidates "$2" true
    else
      usage
    fi
    ;;
  *)
    usage
    ;;
esac
