#!/bin/bash

set -uo pipefail

CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/gh-dash/reviewers"
FAVORITES_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gh-dash/reviewer-favorites"

usage() {
  printf 'usage: %s request <owner/repo> <pr-number>\n' "$0" >&2
  exit 2
}

validate_repo() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    printf 'invalid repository: %s\n' "$1" >&2
    return 1
  }
}

cache_file() {
  printf '%s/%s\n' "$CACHE_ROOT" "$1"
}

refresh_cache() {
  local repo=$1 file temp_file
  file=$(cache_file "$repo")
  mkdir -p "$(dirname "$file")" || return 1
  temp_file=$(mktemp "${file}.tmp.XXXXXX") || return 1

  if ! gh api "repos/${repo}/collaborators?per_page=100" --paginate --jq '.[].login' \
    | LC_ALL=C sort -fu > "$temp_file"; then
    rm -f "$temp_file"
    printf 'could not refresh reviewers for %s\n' "$repo" >&2
    return 1
  fi

  mv "$temp_file" "$file"
}

print_candidates() {
  local repo=$1 refresh=${2:-false} file favorites_source
  validate_repo "$repo" || return 1
  file=$(cache_file "$repo")

  if [ "$refresh" = true ] || [ ! -f "$file" ]; then
    refresh_cache "$repo" || return 1
  fi

  favorites_source=$FAVORITES_FILE
  [ -f "$favorites_source" ] || favorites_source=/dev/null

  awk -v OFS='\t' '
    FILENAME == ARGV[1] {
      if ($0 != "" && !favorite_seen[$0]++) favorites[++favorite_count] = $0
      next
    }
    $0 != "" && !collaborator_seen[$0]++ {
      collaborators[++collaborator_count] = $0
    }
    END {
      for (i = 1; i <= favorite_count; i++) {
        login = favorites[i]
        if (collaborator_seen[login]) print login, "[favorite] " login
      }
      for (i = 1; i <= collaborator_count; i++) {
        login = collaborators[i]
        if (!favorite_seen[login]) print login, login
      }
    }
  ' "$favorites_source" "$file"
}

request_review() {
  local repo=$1 pr=$2 file script_path reload_command selection fzf_status reviewers login
  validate_repo "$repo" || return 1
  [[ "$pr" =~ ^[0-9]+$ ]] || {
    printf 'invalid pull request number: %s\n' "$pr" >&2
    return 1
  }

  file=$(cache_file "$repo")
  [ -f "$file" ] || refresh_cache "$repo" || return 1

  script_path=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  printf -v reload_command '%q candidates %q --refresh' "$script_path" "$repo"

  selection=$(print_candidates "$repo" | fzf \
    --multi \
    --no-sort \
    --delimiter=$'\t' \
    --with-nth=2 \
    --accept-nth=1 \
    --header='tab: select | enter: request | ctrl-r: refresh' \
    --bind="ctrl-r:reload($reload_command)")
  fzf_status=$?

  if [ "$fzf_status" -eq 1 ] || [ "$fzf_status" -eq 130 ]; then
    return 0
  fi
  [ "$fzf_status" -eq 0 ] || return "$fzf_status"

  reviewers=""
  while IFS= read -r login; do
    [ -n "$login" ] || continue
    reviewers="${reviewers:+${reviewers},}${login}"
  done <<< "$selection"

  [ -n "$reviewers" ] || return 0
  gh pr edit "$pr" --repo "$repo" --add-reviewer "$reviewers"
}

case "${1:-}" in
  request)
    [ "$#" -eq 3 ] || usage
    request_review "$2" "$3"
    ;;
  candidates)
    if [ "$#" -eq 2 ]; then
      print_candidates "$2"
    elif [ "$#" -eq 3 ] && [ "$3" = --refresh ]; then
      print_candidates "$2" true
    else
      usage
    fi
    ;;
  *)
    usage
    ;;
esac
