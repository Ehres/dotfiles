#!/bin/bash
# Creates a popup session that passes Escape through to the app
# Usage: tmux-popup-helper.sh [--kill] <name> <command> [args...]

KILL_ON_CLOSE=false
if [[ "$1" == "--kill" ]]; then
    KILL_ON_CLOSE=true
    shift
fi

NAME="_popup_$1"
shift
CMD="$*"

if ! tmux has -t "$NAME" 2>/dev/null; then
    # Pass the command to new-session rather than send-keys: with an empty
    # default-command, new-session would otherwise spawn a login+interactive
    # zsh and run the whole .zshrc (~210ms) before the command even starts.
    # No CMD (the scratch popup) still gets the full shell, on purpose.
    SESSION_ID=$(tmux new-session -dP -s "$NAME" -F '#{session_id}' ${CMD:+"$CMD"})

    tmux set-option -s -t "$SESSION_ID" key-table "popup-$NAME"
    tmux set-option -s -t "$SESSION_ID" status off
    tmux set-option -s -t "$SESSION_ID" prefix None

    if $KILL_ON_CLOSE; then
        tmux bind-key -T "popup-$NAME" C-q run-shell "tmux kill-session -t $NAME"
    else
        tmux bind-key -T "popup-$NAME" C-q detach
    fi

fi

exec tmux attach -t "$NAME" >/dev/null 2>&1
