theme = TokyoNight
# Maple Mono includes Nerd Font glyphs used by tmux and terminal Neovim.
font-family = "Maple Mono NF"
mouse-hide-while-typing = true
window-decoration = true
macos-titlebar-style = hidden
# keybind = global:cmd+/=toggle_quick_terminal
macos-option-as-alt = false
background = #1b1d2a
window-padding-y = 4,0
window-padding-color = background

# Restore windows across restarts.
window-save-state = always

# Not set here, on purpose -- both were tried and removed:
#
# notify-on-command-finish: needs OSC 133 to know where a command starts and
#   ends. tmux absorbs OSC 133 instead of relaying it to the host terminal
#   (measured: zero sequences reached tmux's outer pty), and the block at the top
#   of .zshrc execs into tmux, so no shell here ever reports command boundaries.
#
# shell-integration-features: the sudo/cursor/title features need Ghostty's
#   integration to be running in the shell. Ghostty injects it only into the
#   shell it spawns, which immediately execs tmux, and sourcing it manually from
#   .zshrc broke the prompt (it string-concatenates onto p10k's hooks).
