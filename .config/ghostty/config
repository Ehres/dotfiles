theme = TokyoNight
mouse-hide-while-typing = true
window-decoration = true
macos-titlebar-style = hidden
# keybind = global:cmd+/=toggle_quick_terminal
macos-option-as-alt = false
background = #1b1d2a
window-padding-y = 4,0
window-padding-color = background

# Notify when a command over 10s finishes in an unfocused window.
#
# DOES NOT FIRE UNDER TMUX, which is nearly always here. It needs OSC 133 to
# know where commands begin and end, and tmux absorbs OSC 133 rather than
# relaying it to the host terminal -- measured by capturing what tmux writes to
# its outer pty while a program inside emitted the sequence: zero relayed.
# Kept because it costs nothing and does work in a plain Ghostty window, i.e.
# one started with NO_TMUX=1.
#
# Defaults are never / 5s / bell,no-notify. Values merge rather than replace, so
# `notify` resolves to `bell,notify` and the bell still rings alongside the
# notification -- use no-bell,notify to silence it.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
notify-on-command-finish-action = notify

# Adds `sudo` to the feature set (the default is no-sudo) so terminfo survives
# across sudo. Verified with `ghostty +show-config`: naming features merges with
# the defaults rather than replacing them, so the ssh ones stay at their default
# no-ssh-env,no-ssh-terminfo without needing to be listed.
shell-integration-features = cursor,sudo,title,path

# Restore windows across restarts.
window-save-state = always
