PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors/components.sh"
source "$CONFIG_DIR/spacing/components.sh"
source "$CONFIG_DIR/properties.sh"

##### Bar Appearance #####
sketchybar --bar position=top height=$BAR_HEIGHT blur_radius=0 color=$BAR_BG

##### Default Item Properties #####
default=(
  padding_left=$DEFAULT_PADDING
  padding_right=$DEFAULT_PADDING
  icon.font="Hack Nerd Font:Regular:17.0"
  label.font="Hack Nerd Font:Regular:14.0"
  icon.color=$ICON_DEFAULT
  label.color=$LABEL_DEFAULT
  icon.padding_left=$DEFAULT_ICON_PADDING
  icon.padding_right=$DEFAULT_ICON_PADDING
  label.padding_left=$DEFAULT_LABEL_PADDING
  label.padding_right=$DEFAULT_LABEL_PADDING
)
sketchybar --default "${default[@]}"

##### Items #####
source "$CONFIG_DIR/items/spaces.sh"
source "$CONFIG_DIR/items/system.sh"
source "$CONFIG_DIR/items/network.sh"
source "$CONFIG_DIR/items/communication.sh"
source "$CONFIG_DIR/items/updates.sh"
source "$CONFIG_DIR/items/timer.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
