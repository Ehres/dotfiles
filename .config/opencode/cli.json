{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "leader": "ctrl+space",
    "model.cycle_favorite": "f6"
  },
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "single": true,
    "view": "split"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "autoaccept",
    "verbosity": "medium"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true
  },
  "scroll": {
    "acceleration": true
  },
  "tabs": {
    "mode": "off"
  }
}
