{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "theme": "tokyonight",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.atlassian.com/v1/sse"]
    },

    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/sse"
    },
    "gitlab": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "@zereight/mcp-gitlab"],
      "environment": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "https://git.manomano.tech/api/v4",
        "GITLAB_READ_ONLY_MODE": "false",
        "GITLAB_PROJECT_ID": "1047"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git *": "ask"
        }
      }
    }
  },
  "keybinds": {
    "session_child_cycle": "ctrl+l",
    "session_child_cycle_reverse": "ctrl+h"
  }
}
