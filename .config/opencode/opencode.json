{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "#FF5733"
    },
    "plan": {
      "color": "#86e1fc"
    }
  },
  "autoupdate": true,
  "default_agent": "plan",
  "mcp": {
    "playwright": {
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "cacLAcAKDgi2_dxFx05ilkQ5bpHEJ3vs1HmSYVNjL_o"
      },
      "type": "local"
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "question": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git add *": "ask"
    }
  },
  "plugin": ["@franlol/opencode-md-table-formatter@0.0.3"],
  "username": "Ehres"
}
