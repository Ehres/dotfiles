{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "#FF5733"
    },
    "plan": {
      "color": "#86e1fc"
    }
  },
  "autoupdate": true,
  "lsp": true,
  "mcp": {
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "question": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push --force*": "ask",
      "git reset --hard*": "ask",
      "kubectl * delete *": "ask",
      "*| sh": "ask",
      "*| bash": "ask",
      "security *": "ask",
      "git commit *": "ask"
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-scheduler"
  ],
  "username": "Ehres"
}
