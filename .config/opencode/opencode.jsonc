{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "google-drive": {
      "type": "local",
      "command": ["npx", "-y", "@piotr-agier/google-drive-mcp@2.6.0"],
      "environment": {
        "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "/Users/maxime.grebauval/client_secret_1067784221910-7ckhspsri5f4qoda23v2hc857c69d2ih.apps.googleusercontent.com.json",
        "GOOGLE_DRIVE_MCP_SCOPES": "drive.file,presentations"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": true
    }
  },
  "permission": {
    "question": "allow",
    "external_directory": {
      "~/Library/Application Support/rtk/tee/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "kubectl * delete *": "ask",
      "security *": "ask"
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-scheduler",
    "@mohak34/opencode-notifier@latest",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "username": "Ehres",
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "skill": {
          "*": "allow",
          "brainstorming": "deny",
          "writing-plans": "deny"
        }
      }
    },
    "build": {
      "permission": {
        "skill": {
          "*": "allow",
          "brainstorming": "deny",
          "writing-plans": "deny"
        }
      }
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
