{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
        "disabled": false,
      },
      "google-drive": {
        "type": "local",
        "command": ["npx", "-y", "@piotr-agier/google-drive-mcp@2.6.0"],
        "environment": {
          "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "/Users/maxime.grebauval/client_secret_1067784221910-7ckhspsri5f4qoda23v2hc857c69d2ih.apps.googleusercontent.com.json",
          "GOOGLE_DRIVE_MCP_SCOPES": "drive.file,presentations",
        },
        "disabled": true,
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--no-performance-crux",
        ],
        "disabled": true,
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true,
      },
      "browse": {
        "type": "local",
        "command": [
          "/Users/maxime.grebauval/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      "grafana": {
        "type": "local",
        "disabled": false,
        "command": [
          "/Users/maxime.grebauval/.local/share/mise/shims/uvx",
          "mcp-grafana==2.2.0",
          "-t",
          "stdio",
          "--enabled-tools",
          "search,datasource,dashboard,prometheus",
          "--usage-stats=disabled"
        ],
        "environment": {
          "GRAFANA_URL": "https://orus.grafana.net",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE": "/Users/maxime.grebauval/.local/share/opencode/secrets/grafana-token"
        }
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp"
      },
    },
  },
  "permissions": [
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "~/Library/Application Support/rtk/tee/**",
      "effect": "allow",
    },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * delete *", "effect": "ask" },
    { "action": "shell", "resource": "security *", "effect": "ask" },
  ],
  "plugins": ["@slkiser/opencode-quota@latest"],
  "username": "Ehres",
}
