# Mode state
:: default : sketchybar --trigger yabai_status_update
:: resize @ : sketchybar --trigger yabai_status_update MODE=resize
:: arrange @ : sketchybar --trigger yabai_status_update MODE=arrange
:: move @ : sketchybar --trigger yabai_status_update MODE=move
:: app @ : sketchybar --trigger yabai_status_update MODE=app
:: layout @ : sketchybar --trigger yabai_status_update MODE=layout

# yabai service
ctrl + shift - y : yabai --start-service; brew services start borders; sketchybar --trigger yabai_status_update
ctrl + shift - u : yabai --stop-service; brew services stop borders; sketchybar --trigger yabai_status_update STATE=off
ctrl + shift - i : yabai --restart-service; brew services restart borders; sketchybar --trigger yabai_status_update

# Focus window
ctrl + shift - h : yabai -m window --focus west
ctrl + shift - j : yabai -m window --focus south
ctrl + shift - k : yabai -m window --focus north
ctrl + shift - l : yabai -m window --focus east

# Focus space
ctrl + shift - 1 : yabai -m space --focus 1
ctrl + shift - 2 : yabai -m space --focus 2
ctrl + shift - 3 : yabai -m space --focus 3
ctrl + shift - 4 : yabai -m space --focus 4
ctrl + shift - 5 : yabai -m space --focus 5
ctrl + shift - 6 : yabai -m space --focus 6
ctrl + shift - 7 : yabai -m space --focus 7
ctrl + shift - 8 : yabai -m space --focus 8
ctrl + shift - 9 : yabai -m space --focus 9
ctrl + shift - 0 : yabai -m space --focus 10

# Resize: persistent; h/j/k/l grow and Shift+h/j/k/l shrink
default < ctrl + shift - r ; resize
resize < h : yabai -m window --resize left:-20:0
resize < j : yabai -m window --resize bottom:0:20
resize < k : yabai -m window --resize top:0:-20
resize < l : yabai -m window --resize right:20:0
resize < shift - h : yabai -m window --resize left:20:0
resize < shift - j : yabai -m window --resize bottom:0:-20
resize < shift - k : yabai -m window --resize top:0:20
resize < shift - l : yabai -m window --resize right:-20:0
resize < escape ; default

# Arrange: h/j/k/l swap; Shift+h/j/k/l warp; each action exits
default < ctrl + shift - s ; arrange
arrange < h : yabai -m window --swap west; skhd -k escape
arrange < j : yabai -m window --swap south; skhd -k escape
arrange < k : yabai -m window --swap north; skhd -k escape
arrange < l : yabai -m window --swap east; skhd -k escape
arrange < shift - h : yabai -m window --warp west; skhd -k escape
arrange < shift - j : yabai -m window --warp south; skhd -k escape
arrange < shift - k : yabai -m window --warp north; skhd -k escape
arrange < shift - l : yabai -m window --warp east; skhd -k escape
arrange < escape ; default

# Move: simple keys move; Shift follows the destination; each action exits
default < ctrl + shift - m ; move
move < 1 : yabai -m window --space 1; skhd -k escape
move < 2 : yabai -m window --space 2; skhd -k escape
move < 3 : yabai -m window --space 3; skhd -k escape
move < 4 : yabai -m window --space 4; skhd -k escape
move < 5 : yabai -m window --space 5; skhd -k escape
move < 6 : yabai -m window --space 6; skhd -k escape
move < 7 : yabai -m window --space 7; skhd -k escape
move < 8 : yabai -m window --space 8; skhd -k escape
move < 9 : yabai -m window --space 9; skhd -k escape
move < 0 : yabai -m window --space 10; skhd -k escape
move < shift - 1 : yabai -m window --space 1 && yabai -m space --focus 1; skhd -k escape
move < shift - 2 : yabai -m window --space 2 && yabai -m space --focus 2; skhd -k escape
move < shift - 3 : yabai -m window --space 3 && yabai -m space --focus 3; skhd -k escape
move < shift - 4 : yabai -m window --space 4 && yabai -m space --focus 4; skhd -k escape
move < shift - 5 : yabai -m window --space 5 && yabai -m space --focus 5; skhd -k escape
move < shift - 6 : yabai -m window --space 6 && yabai -m space --focus 6; skhd -k escape
move < shift - 7 : yabai -m window --space 7 && yabai -m space --focus 7; skhd -k escape
move < shift - 8 : yabai -m window --space 8 && yabai -m space --focus 8; skhd -k escape
move < shift - 9 : yabai -m window --space 9 && yabai -m space --focus 9; skhd -k escape
move < shift - 0 : yabai -m window --space 10 && yabai -m space --focus 10; skhd -k escape
move < h : yabai -m window --display west; skhd -k escape
move < j : yabai -m window --display south; skhd -k escape
move < k : yabai -m window --display north; skhd -k escape
move < l : yabai -m window --display east; skhd -k escape
move < shift - h : yabai -m window --display west && yabai -m display --focus west; skhd -k escape
move < shift - j : yabai -m window --display south && yabai -m display --focus south; skhd -k escape
move < shift - k : yabai -m window --display north && yabai -m display --focus north; skhd -k escape
move < shift - l : yabai -m window --display east && yabai -m display --focus east; skhd -k escape
move < escape ; default

# App: focus the MRU usable window, or launch the app; each action exits
default < ctrl + shift - a ; app
app < s : "$HOME/scripts/yabai-focus-app" Slack; skhd -k escape
app < t : "$HOME/scripts/yabai-focus-app" Ghostty; skhd -k escape
app < b : "$HOME/scripts/yabai-focus-app" Dia; skhd -k escape
app < e : "$HOME/scripts/yabai-focus-app" Mail; skhd -k escape
app < m : "$HOME/scripts/yabai-focus-app" Messages; skhd -k escape
app < n : "$HOME/scripts/yabai-focus-app" Notion; skhd -k escape
app < d : "$HOME/scripts/yabai-focus-app" Discord; skhd -k escape
app < a : "$HOME/scripts/yabai-focus-app" Arc; skhd -k escape
app < l : "$HOME/scripts/yabai-focus-app" Linear; skhd -k escape
app < escape ; default

# Layout: one action then exit
default < ctrl + shift - o ; layout
layout < f : yabai -m window --toggle zoom-fullscreen; skhd -k escape
layout < t : yabai -m window --toggle float; yabai -m window --grid 20:20:3:3:14:14; skhd -k escape
layout < 1 : yabai -m space --balance; yabai -m window --ratio abs:0.33; skhd -k escape
layout < 2 : yabai -m space --balance; yabai -m window --ratio abs:0.66; skhd -k escape
layout < b : yabai -m space --balance; skhd -k escape
layout < escape ; default
