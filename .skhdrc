# yabai service
ctrl + shift - y : yabai --start-service
ctrl + shift - u : yabai --stop-service
ctrl + shift - i : yabai --restart-service

# focus window
ctrl + shift - h : yabai -m window --focus west
ctrl + shift - j : yabai -m window --focus south
ctrl + shift - k : yabai -m window --focus north
ctrl + shift - l : yabai -m window --focus east

# swap managed window
shift + ctrl + cmd - h : yabai -m window --swap west
shift + ctrl + cmd - l : yabai -m window --swap east
shift + ctrl + cmd - j : yabai -m window --swap south
shift + ctrl + cmd - k : yabai -m window --swap north

# move managed window
ctrl + cmd - h : yabai -m window --warp west
ctrl + cmd - j : yabai -m window --warp south
ctrl + cmd - k : yabai -m window --warp north 
ctrl + cmd - l : yabai -m window --warp east

# fast focus desktop
ctrl + shift - 1 : yabai -m space --focus 1
ctrl + shift - 2 : yabai -m space --focus 2
ctrl + shift - 3 : yabai -m space --focus 3
ctrl + shift - 4 : yabai -m space --focus 4
ctrl + shift - 5 : yabai -m space --focus 5
ctrl + shift - 6 : yabai -m space --focus 6
ctrl + shift - 7 : yabai -m space --focus 7
ctrl + shift - 8 : yabai -m space --focus 8
ctrl + shift - 9 : yabai -m space --focus 9
ctrl + shift - 0 : yabai -m space --focus 10

# send window to desktop and follow focus
shift + alt - 1 : yabai -m window --space  1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space  2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space  3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space  4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space  5; yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space  6; yabai -m space --focus 6
shift + alt - 7 : yabai -m window --space  7; yabai -m space --focus 7
shift + alt - 8 : yabai -m window --space  8; yabai -m space --focus 8
shift + alt - 9 : yabai -m window --space  9; yabai -m space --focus 9
shift + alt - 0 : yabai -m window --space  10; yabai -m space --focus 10

# resize window (vim-style: grow in direction)
shift + alt - h : yabai -m window --resize left:-20:0
shift + alt - j : yabai -m window --resize bottom:0:20
shift + alt - k : yabai -m window --resize top:0:-20
shift + alt - l : yabai -m window --resize right:20:0

# toggle window zoom
ctrl + shift - f : yabai -m window --toggle zoom-fullscreen

ctrl + shift + cmd - f : yabai -m window --toggle float 
ctrl + shift + cmd - s: yabai -m window --toggle sticky

# App shortcuts 
ctrl + shift - s : open -a 'Slack'
ctrl + shift - t : open -a 'Ghostty'
ctrl + shift - b : open -a 'Dia'
ctrl + shift - e : open -a 'Mail'
ctrl + shift - m : open -a 'Messages'
ctrl + shift - n : open -a 'Notion'
ctrl + shift - d : open -a 'Discord'
ctrl + shift - a : open -a 'Arc'
