node_modules
.tmux/plugins
network.out
.worktrees/

# Skills synchronized locally by an external tool.
.agents/skills/synced/

# opencode runtime state, not configuration. The README documents
# `git add . && git commit` as the backup routine, which would otherwise commit
# scheduler locks and scope paths named after work repos.
.opencode/plans/*
.config/opencode/logs/
.config/opencode/jobs/
.config/opencode/scheduler/scopes/
.config/opencode/opencode-notifier-state.json

# gh-dash reviewer ranking state, updated after every selection.
.config/gh-dash/reviewer-scores

# Superpowers specs and plans are working documents for the agent session,
# not configuration. They stay on disk but are never versioned.
docs/superpowers/
.superpowers/
